# Copy to .env.local for local use. Never commit populated secrets.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_LAYOUT_MODEL=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-1.5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:5174
PRICE_CENTS=2900
REGULAR_PRICE_CENTS=5900
SALES_ENABLED=false
# Minimum 20 random characters. Required locally and in production.
ADMIN_PASSWORD=
DEMO_PDF_ORDER_ID=
DAILY_GENERATION_LIMIT=0
# Dzienny limit wydatków OpenAI w groszach (500 = 5 zł/dobę wg Europe/Warsaw), tylko opłacone zamówienia.
# OpenAI rozlicza w USD: koszt liczony z cennika w USD i przeliczany stałym, konserwatywnym kursem poniżej.
OPENAI_DAILY_COST_CAP_GROSZE=500
OPENAI_USD_PLN_RATE=4.00
# Adres na alerty o limicie (80%/100%) i zamówieniach needs_refund.
OWNER_ALERT_EMAIL=
